{
	"name": "skywatch-qa-platform",
	"version": "2.0.2",
	"private": true,
	"scripts": {
		"clean:next": "node ./scripts/clean-next.cjs",
		"dev": "next dev -H 0.0.0.0 -p 3000",
		"dev:clean": "npm run clean:next && next dev -H 0.0.0.0 -p 3000",
		"build": "npm run clean:next && next build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"start": "next start -H 0.0.0.0 -p 3000"
	},
	"dependencies": {
		"next": "16.3.4",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@types/node": "20.14.12",
		"@types/react": "18.3.3",
		"@types/react-dom": "18.3.0",
		"jsdom": "27.1.0",
		"typescript": "5.5.4",
		"vitest": "4.1.11"
	}
}
