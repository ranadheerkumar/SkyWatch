# SkyWatch Environment Configuration
# Copy these into the shell or a local ignored environment file.

# ============================================================================
# APPLICATION LOGIN CONFIGURATION
# ============================================================================
# Supply login_email/login_password as sensitive runtime parameters in the UI.
# Configure target-specific login selectors in the execution or AI Generator UI.

# ============================================================================
# AI PROVIDER CONFIGURATION
# ============================================================================
# Choose one explicit AI_PROVIDER: github_copilot | openai | azure_openai | anthropic | gemini | local
# Choose AI_PROVIDER: auto | gemini | github_copilot | openai | azure_openai | anthropic | local
# When set to "auto", SkyWatch automatically detects whichever provider has valid credentials.
AI_PROVIDER=auto
AI_MODEL=gemini-2.0-flash

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# GitHub Copilot / GitHub Models Token (e.g. ghp_... or github_pat_...)
GITHUB_TOKEN=your-github-personal-access-token-or-copilot-token
COPILOT_API_KEY=

# OpenAI credentials (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude credentials (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=45

# ============================================================================
# AI GENERATION & TEST PLANNING PARAMETERS (Configurable, unconstrained)
# ============================================================================
# Dynamic planning targets and generator batching
AI_DEFAULT_CASE_TARGET=20
AI_MIN_CASE_TARGET=10
AI_MAX_CASE_TARGET=100
AI_GENERATOR_BATCH_SIZE=15
AI_MAX_GENERATOR_CALLS=20
AI_EXPLORATORY_ACTION_LIMIT=16

# Document Analysis ingestion limits
AI_MAX_UPLOAD_DOCUMENTS=50
AI_MAX_DOCUMENT_BYTES=31457280
AI_MAX_DOCUMENT_CONTEXT_CHARS=250000

# ============================================================================
# MULTI-ENVIRONMENT EXECUTION PROVIDER CONFIGURATION
# ============================================================================
# Provider choices: local | sauce_labs | lambdatest | docker | azure | gcp | aws
# Default is "local" (zero cloud credentials required, 100% offline capable)
SKYWATCH_EXECUTION_PROVIDER=local

# Sauce Labs Cloud Grid credentials (optional)
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
SAUCE_REGION=us-west-1
SAUCE_TUNNEL_IDENTIFIER=

# LambdaTest Automation Grid credentials (optional)
LT_USERNAME=
LT_ACCESS_KEY=
LT_TUNNEL=false

# Cloud Container Runner target (optional: docker | azure | gcp | aws)
CLOUD_RUNNER_TARGET=docker
AZURE_CONTAINER_APP_URL=
GCP_CLOUD_RUN_JOB=
AWS_ECS_CLUSTER=

# ============================================================================
# EXECUTION SETTINGS
# ============================================================================
# Execution mode: "watch_live" (visible browser) or "background" (headless)
SKYWATCH_EXECUTION_MODE=watch_live

# Keep browser open after failure for inspection (seconds)
SKYWATCH_KEEP_BROWSER_OPEN_SECONDS=6

# Enable screenshot capture during execution
SKYWATCH_CAPTURE_SCREENSHOTS=true

# Enable video recording during execution
SKYWATCH_RECORD_VIDEO=false

# Highlight the current action target in the visible browser
SKYWATCH_ACTION_HIGHLIGHT=true
# Minimum time the red action block remains visible before the action starts
SKYWATCH_ACTION_HIGHLIGHT_HOLD_MS=400

# ============================================================================
# QUEUE & PERSISTENCE SETTINGS
# ============================================================================
SKYWATCH_QUEUE_BACKEND=local
SKYWATCH_QUEUE_NAME=skywatch-runs
SKYWATCH_REDIS_URL=redis://127.0.0.1:6379/0

# ============================================================================
# SECRETS MANAGEMENT
# ============================================================================
# Secrets provider: "env" (environment variables) or "vault" (HashiCorp Vault)
SKYWATCH_SECRET_PROVIDER=env

# Vault settings (optional, for production)
SKYWATCH_VAULT_ADDR=
SKYWATCH_VAULT_TOKEN=
SKYWATCH_VAULT_PATH=secret/data/skywatch

# ============================================================================
# SECURITY & NETWORK
# ============================================================================
# Allow running tests against private/internal IP ranges
ALLOW_PRIVATE_TARGETS=false

# ============================================================================
# READ-ONLY JIRA AND QTEST INTEGRATIONS
# ============================================================================
# These values are read by the backend only. External records are never mutated.
SKYWATCH_INTEGRATIONS_READ_ONLY=true
SKYWATCH_INTEGRATION_TIMEOUT_SECONDS=15
SKYWATCH_INTEGRATION_MAX_RESPONSE_BYTES=2000000
SKYWATCH_INTEGRATION_MAX_ASSET_ITEMS=100
SKYWATCH_INTEGRATION_USER_AGENT=SkyWatch/2.0

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_FILTER_ID=
JIRA_PROFILE_NAME=
JIRA_CREDENTIAL_ENV_NAME=JIRA_API_TOKEN

QTEST_BASE_URL=
QTEST_TOKEN=
QTEST_PROJECT_ID=
QTEST_PROJECT_NAME=
QTEST_PROFILE_NAME=
QTEST_CREDENTIAL_ENV_NAME=QTEST_TOKEN

# Compatibility flags remain disabled while integrations are read-only.
ENABLE_JIRA_WRITE=false
ENABLE_QTEST_WRITE=false

# ============================================================================
# GIT REPOSITORY INTEGRATION (GITHUB)
# ============================================================================
# Dedicated personal access token for Git repository operations (repo scope).
# Separate from GITHUB_TOKEN used for GitHub Copilot / LLM models.
GITHUB_GIT_TOKEN=
# Target repository in owner/repo format (e.g. your-org/e2e-tests)
GITHUB_GIT_REPO=
# Target branch for script commits (leave empty for smart auto-resolution to default branch)
GITHUB_GIT_BRANCH=
# Base directory path within repository where generated test scripts are committed
GITHUB_GIT_BASE_PATH=tests/skywatch/
# Enable or disable remote Git push operations
ENABLE_GIT_PUSH=true
